    b"\x1b[1;2C": 1, b"\x1b[1;2D": -1, b"\x1b[1;2A": 5, b"\x1b[1;2B": -5,
    b"h": -5, b"l": 5, b"j": -60, b"k": 60,  # not mpv's: vim's keys, as the arrows (images step, turn and pan with them)
}
SPEEDS = {  # mpv's [ ] { } and backspace, plus \ as its reset: percent to percent
    b"]": lambda s: s * 1.1, b"[": lambda s: s / 1.1, b"}": lambda s: s * 2, b"{": lambda s: s / 2,
    b"\x7f": lambda s: 100, b"\x08": lambda s: 100, b"\\": lambda s: 100,
}
