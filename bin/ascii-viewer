PLAYING, PAUSED, STOPPED = "playing", "paused", "stopped"


@functools.lru_cache(maxsize=2)
def checkerboard(size):
    """The transparency checkerboard of size (w, h) as RGB bytes, in CHECKER_PX squares."""
    w, h = size
    cell = ((np.arange(h)[:, None] // CHECKER_PX + np.arange(w)[None, :] // CHECKER_PX) & 1).astype(np.uint8)
    return np.repeat(np.array(CHECKER, np.uint8)[cell][..., None], 3, 2).tobytes()


def cut(picture, box, scale, background, key, kept):
    """The box (left, top, right, bottom) of picture, in its px, scaled by scale (at least 1 px
    a side), as (what, (w, h, RGB bytes)), what being (key, the box to 0.01 px, the size);
    kept, an earlier return, comes back as it is when its what is the same. Enlarged by nearest
    neighbour, so each picture px shows as a block; reduced by bicubic. Transparency shows
    over background: a colour, or background(size), an RGB image of that size to paint on."""
    from PIL import Image

    left, top, right, bottom = box
    size = (max(1, round((right - left) * scale)), max(1, round((bottom - top) * scale)))
    what = (key, tuple(round(v, 2) for v in box), size)
    if kept and kept[0] == what:
        return kept
    shown = picture.resize(size, Image.NEAREST if scale > 1 else Image.BICUBIC, box=box, reducing_gap=2.0)
    if shown.mode == "RGBA" and callable(background):
        background = background(size)
    shown = flatten(shown, background)
    return what, (shown.width, shown.height, shown.tobytes())


def next_glyphs(mode, step=1):
    """The glyph mode step places on from mode in ascii_density's MODES, wrapping round (g)."""
    return density.MODES[(density.MODES.index(mode) + step) % len(density.MODES)]


def kitty_reads_files():
    """Whether the terminal reads an image from a file in /dev/shm (kitty's t=t), as the image
    view sends them: a query (a=q) for a one-pixel file, answered OK, before the reply to a
    device attributes request, which every terminal answers. Over kitten ssh the file would be
    on another machine. Needs the terminal in cbreak mode; a key typed meanwhile is lost. Waits
    PROBE_WAIT seconds at most: poll() drops what answers later (REPLY)."""
    fd, path = tempfile.mkstemp(prefix="tty-graphics-protocol-", dir="/dev/shm")
    os.write(fd, b"\0\0\0")
    os.close(fd)
    try:
        os.write(1, b"\x1b_Gi=31,s=1,v=1,a=q,t=t,f=24;%s\x1b\\\x1b[c" % base64.b64encode(path.encode()))
        reply, end = b"", time.monotonic() + PROBE_WAIT
        while not re.search(rb"\x1b\[\?[0-9;]*c", reply) and (left := end - time.monotonic()) > 0:
            if not select.select([0], [], [], left)[0]:
                break
            reply += os.read(0, 1024)
        return b"\x1b_Gi=31;OK\x1b\\" in reply
    finally:
        Path(path).unlink(missing_ok=True)


PNG_MODES = {"1", "L", "LA", "I", "I;16", "P", "RGB", "RGBA"}  # what Pillow writes as PNG unconverted


def original_png(path, rotation):
    """The still image at path at its own size (an SVG at the size it declares), upright and
    turned rotation quarters right: PNG bytes, transparency kept, and its (width, height)."""
    picture = upright(path)
    if rotation:
        picture = picture.rotate(-90 * rotation, expand=True)
    if picture.mode not in PNG_MODES:  # CMYK, YCbCr, float, PA
        picture = picture.convert("RGBA" if picture.has_transparency_data else "RGB")
    out = io.BytesIO()
    picture.save(out, "PNG", compress_level=1)  # the clipboard is short-lived: speed over size
    return out.getvalue(), picture.size


def sibling_images(path):
    """Every file beside path that Pillow opens by its extension, or an SVG, sorted by name, as
    qView steps through a folder."""
    from PIL import Image

    known = {*Image.registered_extensions(), ".svg"}
    folder = Path(path).parent.resolve()  # the folder the entry is in, not its link target's
    return sorted((f for f in folder.iterdir() if f.suffix.lower() in known and f.is_file()), key=lambda f: f.name.lower())


Trashed = namedtuple("Trashed", "path stored info ident")  # a trashed file: where it was, where it is, its .trashinfo, its (st_dev, st_ino)


class TrashGone(Exception):
    """The trash no longer holds the file that was put there: emptied, restored elsewhere, or
    the name reused."""


def home_trash():
    """The home trash: $XDG_DATA_HOME/Trash, ~/.local/share/Trash when that is unset."""
    data = os.environ.get("XDG_DATA_HOME")
    return Path(data if data and os.path.isabs(data) else "~/.local/share").expanduser() / "Trash"


def mount_point(path):
    """The mount point of the file system holding path."""
    path = Path(path).resolve()
    while not path.is_mount() and path != path.parent:
        path = path.parent
    return path


def same_device(path, trash):
    """Whether the file at path shares a device with trash, a directory that may not exist."""
    while not os.path.lexists(trash):
        trash = trash.parent
    return os.lstat(path).st_dev == os.stat(trash).st_dev


def trash_dirs(path):
    """[(trash directory, topdir)] to try in order for the file at path, as the Trash spec 1.0
    has it: the home trash (topdir None) on the file's own device, else on its mount point
    $topdir the shared $topdir/.Trash/$uid if .Trash is a sticky directory and no symlink, then
    $topdir/.Trash-$uid, which is also the way out when the first cannot be made."""
    home = home_trash()
    if same_device(path, home):
        return [(home, None)]
    top = mount_point(path.parent)
    shared = top / ".Trash"
    try:
        mode = shared.lstat().st_mode
        usable = stat.S_ISDIR(mode) and mode & stat.S_ISVTX
    except OSError:
        usable = False
    own = (top / f".Trash-{os.getuid()}", top)
    return [(shared / str(os.getuid()), top), own] if usable else [own]


def trash_ready(folder, shared):
    """Make the trash directory folder with its files/ and info/ and return those two. OSError
    unless each is a directory of this user; for a topdir trash (shared, on a mount others may
    write to) also no symlink, or another user could have set it up to read or remove what
    lands in it."""
    def check(d):
        st = d.lstat() if shared else d.stat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            raise PermissionError(f"{d} is not a directory of this user")

    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    check(folder)  # before anything is made inside it
    files, info = folder / "files", folder / "info"
    for sub in (files, info):
        sub.mkdir(exist_ok=True, mode=0o700)
        check(sub)
    return files, info


def trash(path):
    """Move the file at path to the trash (trash_dirs), without copying: a Trashed. The
    .trashinfo is made first, exclusively, reserving a name free in the trash (name, name.2,
    name.3 ... before the extension), and removed again if the move fails (OSError). Its Path,
    percent-encoded, is absolute in the home trash, else relative to the topdir."""
    path = path.parent.resolve() / path.name  # the folder as it really is; a symlink itself is what moves
    error = None
    for folder, top in trash_dirs(path):
        try:
            files, info = trash_ready(folder, top is not None)
            break
        except OSError as e:
            error = e
    else:
        raise error
    text = f"[Trash Info]\nPath={quote(os.fsencode(os.path.relpath(path, top) if top else path))}\n"
    text += f"DeletionDate={time.strftime('%Y-%m-%dT%H:%M:%S')}\n"
    base, ext = os.path.splitext(path.name)
    n = 1
    while True:
        name = path.name if n == 1 else f"{base}.{n}{ext}"
        n += 1
        if os.path.lexists(files / name):  # a file the trash holds without a .trashinfo
            continue
        try:
            fd = os.open(info / f"{name}.trashinfo", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError:
            continue
    stored, info_file = files / name, info / f"{name}.trashinfo"
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        st = os.lstat(path)  # a rename keeps the inode: this is the stored file's identity
        os.rename(path, stored)
    except OSError:
        info_file.unlink(missing_ok=True)
        raise
    return Trashed(path, stored, info_file, (st.st_dev, st.st_ino))


def untrash(entry):
    """Put a trashed file back where it was and drop its .trashinfo. FileExistsError, nothing
    changed, when something is there now: the link is made first, so a file that appears
    meanwhile is not replaced. TrashGone, nothing changed, when the stored name is no longer
    the file trashed (or has lost its .trashinfo): it would be someone else's."""
    try:
        st = os.lstat(entry.stored)
    except FileNotFoundError:
        raise TrashGone(str(entry.stored)) from None
    if (st.st_dev, st.st_ino) != entry.ident or not os.path.lexists(entry.info):
        raise TrashGone(str(entry.stored))
    try:
        os.link(entry.stored, entry.path, follow_symlinks=False)
    except FileExistsError:
        raise
    except OSError:  # no hard links here (or a directory): check, then move
        if os.path.lexists(entry.path):
            raise FileExistsError(str(entry.path)) from None
        os.rename(entry.stored, entry.path)
    else:
        os.unlink(entry.stored)
    entry.info.unlink(missing_ok=True)


def probe(path):
    """(the file opened by PyAV, the video stream to play or None, whether it has audio, length
    in seconds, inf when unknown). Exits with PyAV's message, or when path has neither."""
    import av

    try:
        container = av.open(path)
    except (av.error.FFmpegError, OSError) as e:
        sys.exit(f"ascii-viewer: {e}")
    # cover art is a video stream too, but a still: it holds no frame rate worth playing
    video = next((s for s in container.streams.video if not s.disposition & av.stream.Disposition.attached_pic), None)
    audio = bool(container.streams.audio)
    if not video and not audio:
        sys.exit(f"ascii-viewer: no video or audio stream in {path}")
    length = container.duration / av.time_base if container.duration else math.inf
    return container, video, audio, length


def play_rate(stream):
    """The rate a video stream plays at: its average (25 if unknown), at most MAX_FPS."""
    rate = stream.average_rate
    return min(Fraction(rate.numerator, rate.denominator) if rate else Fraction(25), MAX_FPS)


class Decoder:
    """Video frames decoded in this process by PyAV (FFmpeg's libraries) from the file kept
    open, as (w, h, RGB bytes): upright (a phone video's display matrix applied), within
    MAX_W x MAX_H, one per period of fps. Each frame shows at the time it is due: the last one
    held across a variable-rate gap, frames skipped when the source runs faster than fps."""

    def __init__(self, container, stream, fps):
        import av

        self.av, self.container, self.stream = av, container, stream
        self.stream.thread_type = "AUTO"  # frame and slice threads
        self.period = 1 / float(fps)
        # mpv's time-pos counts from the container's start, past 0 in MPEG-TS and some MKV
        self.start = (self.container.start_time or 0) / av.time_base
        self.frames, self.pending, self.last, self.due = None, None, None, 0.0

    def seek(self, at):
        """Decode from at seconds: from the keyframe before it, forward to it. Some containers
        (MPEG-TS) land past it, on the next frame that decodes: then from earlier."""
        back = 0
        while True:
            target = max(at - back, 0)
            self.container.seek(int((target + self.start) / self.stream.time_base), stream=self.stream, backward=True)
            self.frames = self.container.decode(self.stream)
            first = self.next_frame()
            if not target or first is None or first.time is None or first.time - self.start <= at + self.period / 2:
                break
            back = back * 2 or 1
        self.pending, self.last, self.due = first, None, at
        return Run(self)

    def next_frame(self):
        while True:
            try:
                return next(self.frames)
            except StopIteration:
                return None
            except self.av.error.EOFError:
                return None
            except self.av.error.InvalidDataError:  # a damaged frame: the next one may decode
                continue

    def read(self):
        """The frame due next, or None at the end."""
        half = self.period / 2
        while True:
            if self.pending is None:
                self.pending = self.next_frame()
                if self.pending is None:
                    return None
            frame = self.pending
            t = frame.time - self.start if frame.time is not None else self.due
            if t < self.due - half:  # before the wanted time: a seek's run-up, or a frame fps drops
                self.last, self.pending = frame, None
                continue
            if t <= self.due + half:
                self.last, self.pending, out = frame, None, frame
            else:  # the next frame comes later than due: hold the last one (variable frame rate)
                out = self.last or frame
            self.due += self.period
            return self.picture(out)

    def picture(self, frame):
        turned = frame.rotation % 180 != 0
        w, h = (frame.height, frame.width) if turned else (frame.width, frame.height)
        scale = min(MAX_W / w, MAX_H / h, 1)
        tw, th = max(2, round(w * scale / 2) * 2), max(2, round(h * scale / 2) * 2)
        if turned:
            tw, th = th, tw
        scaled = frame.reformat(width=tw, height=th, format="rgb24")
        if not frame.rotation:  # the array's bytes, without the round trip through a Pillow image
            return scaled.width, scaled.height, scaled.to_ndarray().tobytes()
        image = scaled.to_image().rotate(frame.rotation, expand=True)
        return image.width, image.height, image.tobytes()

    def close(self):
        self.container.close()


class Run:
    """One run of the decoder from a seek: Player.proc, whose identity marks a seek."""

    def __init__(self, decoder):
        self.read = decoder.read


def ask(f, *command):
    """Send one command over an mpv IPC stream and return its reply, a dict with "error" and
    "data", skipping the events in between. None when the stream ends."""
    f.write(json.dumps({"command": command, "request_id": 1}).encode() + b"\n")
    f.flush()
    while line := f.readline():
        reply = json.loads(line)
        if reply.get("request_id") == 1:
            return reply


def close(f):
    try:
        f.close()
    except OSError:  # closing flushes a command mpv never read
        pass


_CONVERT = None


def convert_module():
    """ascii-convert loaded as a module, once: the render page draws with its own Style, so the
    page shows exactly what the file will hold."""
    global _CONVERT
    if _CONVERT is None:
        _CONVERT = load_script(CONVERT, "ascii_convert")
    return _CONVERT


def kitty_themes():
    """kitty's dark themes as [(name, colours)], colours as ascii_theme.theme() gives them,
    read straight from kitty's own cache of its collection (what kitten themes lists)."""
    try:
        with kitty_theme_index() as (entries, read):
            out = []
            for t in entries:
                if t.get("is_dark"):
                    try:
                        out.append((t["name"], theme(read(t))))
                    except KeyError:
                        pass
            return out
    except (OSError, ValueError, KeyError):
        return []


def screen_size():
    """The focused monitor's (width, height) in px, from hyprctl; () when it does not say."""
    try:
        monitors = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout)
        mon = next(m for m in monitors if m["focused"])
        return mon["width"], mon["height"]
    except (OSError, ValueError, StopIteration, KeyError):
        return ()


def tone_label(level):
    """Level in words: darker above 0 (black point up), brighter below (white point down)."""
    if not level:
        return "0"
    return f"{abs(level)}% {'darker' if level > 0 else 'brighter'}"


def contrast_label(contrast):
    return f"{contrast:+d}%" if contrast else "0"


def swatch(colours):
    """A theme's 16 colours as a strip of coloured blocks (truecolour), for the theme list."""
    def block(hex_colour):
        return "\x1b[38;2;%d;%d;%dm█" % rgb(hex_colour)
    return "".join(block(colours[f"color{i}"]) for i in range(16) if f"color{i}" in colours) + "\x1b[39m"


class RenderPage:
    """r: the picture on screen rendered to a PNG, interactively, in archinstall's manner:
    settings on the left, then the actions Export and Back; on the right the picture as the
    file will hold it, shown by kitty; in the theme list it follows the theme under the cursor,
    beside a strip of its 16 colours. Keys: the module docstring.

    Density is a character's size in the exported image, in px of the font (ascii-convert's 20
    by default); the columns follow from it and the output width, and a typed column count sets
    the density that gives it. It draws with ascii-convert's own code (convert_module), so the
    preview and the file are the same image."""

    WIDTH = 46  # cells of the menu column
    SIZES = ["1920 long side", "1080 long side", "3840 long side", "screen"]
    MENU = ["level", "contrast", "saturation", "skin", "glyphs", "density", "columns", "fit", "crop", "cropw", "croph", "cropx", "cropy",
            "size", "theme", "bold", "mono"]
    # number settings: (step for h l, low, high)
    STEPS = {"level": (5, *LIMITS["level"]), "contrast": (5, *LIMITS["contrast"]), "saturation": (10, *LIMITS["saturation"]),
             "cropw": (5, 5, 400), "croph": (5, 5, 400), "cropx": (5, -300, 300), "cropy": (5, -300, 300)}
    ACTIONS = ["export", "back"]
    LABELS = {"level": "Level", "contrast": "Contrast", "saturation": "Saturation", "skin": "Skin",
              "fit": "Fit", "glyphs": "Glyphs", "crop": "Crop", "cropw": "Crop W", "croph": "Crop H", "cropx": "Crop X", "cropy": "Crop Y",
              "density": "Density", "columns": "Columns",
              "size": "Size", "theme": "Theme", "bold": "Bold", "mono": "Mono",
              "export": "Export", "back": "Back"}
    DENSITY = (4, 120)  # px of the font, the slider's range
    # ` puts these back (density: ascii-convert's SIZE); the page opens on the player's look
    DEFAULTS = {"level": 0, "contrast": 0, "size": 0, "custom": None, "theme": 0, "bold": False, "mono": False,
                "saturation": 100, "skin": True, "fit": "contain", "glyphs": "mixed",
                "cropw": 100, "croph": 100, "cropx": 0, "cropy": 0}
    RESETS = {"columns": ("density",), "size": ("size", "custom"), "crop": ("cropw", "croph", "cropx", "cropy")}
    LOOK = ("level", "contrast", "saturation", "glyphs", "bold", "mono")  # what the page opens on as the player has it

    def __init__(self, player, picture, out):
        self.player, self.picture, self.out = player, picture, out
        self.convert = convert_module()
        self.themes = [("current", theme()), *kitty_themes()]
        look = self.convert.parser.parse_args([*player.convert_args(), str(out)])  # as a screenshot hands it over
        self.values = {**self.defaults(), **{name: getattr(look, name) for name in self.LOOK}}
        self.cropped = {}  # the picture cropped (--crop), by crop
        self.screen = None  # the focused monitor's size, once "screen" is chosen; () if unknown
        self.cropping = False  # the crop editor is open
        self.ratio = 0  # index into RATIOS
        self.crop_view = None  # (crop, cols, rows) the crop editor's picture was last sent for
        self.items = self.MENU + self.ACTIONS
        self.at = 0
        self.prompt = None  # (item, typed text) while a value is typed
        self.list = None  # {"kind": "size"|"theme", "query", "searching", "at_theme", "at"} while a list is open
        self.message = ""
        self.shrunk = {}  # the cropped source shrunk to chafa's sampling width, by crop and width
        self.style, self.style_key = None, None
        self.twin, self.twin_key = None, None  # the preview's Style: style.scaled() to the box
        # The worker thread draws; this one only takes keys and writes the screen. render()
        # leaves the settings in self.wanted, replacing any the worker has not taken yet, so
        # held keys never queue: the worker draws the latest, then wakes poll().
        self.cv = threading.Condition()
        self.wanted, self.done, self.busy, self.running = None, None, False, True
        self.failure = None  # (version, what went wrong) of the last render that failed
        self.box = None  # the preview's room in px, set by draw()
        self.shown = None  # (version, terminal size) on screen
        self.version = 0
        from PIL import Image, ImageFont

        self.Image = Image
        font = ImageFont.truetype(self.convert.font_path(False), 100)
        self.cell_ratio = font.getlength("M") / 100  # cell width per px of font size
        threading.Thread(target=self.work, daemon=True).start()

    # ---- the numbers behind the settings

    def defaults(self):
        return {**self.DEFAULTS, "density": float(self.convert.SIZE)}

    def target(self):
        """The output size in px."""
        v = self.values
        if v["custom"]:
            return v["custom"]
        preset = self.SIZES[v["size"]]
        if preset == "screen":
            if self.screen is None:
                self.screen = screen_size()
            if self.screen:
                return self.screen
            preset = self.SIZES[0]
        v = self.values  # the crop's shape, so a crop of another shape gets an output of its shape
        w, h = self.convert.web_size((self.picture.width * v["cropw"] / 100, self.picture.height * v["croph"] / 100))
        long = int(preset.split()[0])
        return round(w * long / 1920 / 2) * 2, round(h * long / 1920 / 2) * 2

    def columns(self):
        """The columns the density gives across the output, within ascii-convert's COLUMNS."""
        low, high = self.convert.COLUMNS
        return min(max(round(self.target()[0] / (self.values["density"] * self.cell_ratio)), low), high)

    def set_columns(self, cols):
        low, high = self.convert.COLUMNS
        self.values["density"] = self.target()[0] / (min(max(cols, low), high) * self.cell_ratio)

    def render(self):
        """Ask the worker for the picture with the settings as they are now."""
        v = self.values
        args = self.convert.parser.parse_args([str(self.out)])
        args.bold, args.mono, args.level, args.contrast = v["bold"], v["mono"], v["level"], v["contrast"]
        theme_at = self.list["at_theme"] if self.list and self.list["kind"] == "theme" else v["theme"]
        name, colours = self.themes[theme_at]
        args.theme = None if theme_at == 0 else name
        args.width, args.height = self.target()
        args.columns = self.columns()
        args.saturation, args.fit, args.glyphs = v["saturation"], v["fit"], v["glyphs"]
        args.skin = "grey" if v["skin"] else "theme"
        args.crop = (v["cropx"], v["cropy"], v["cropw"], v["croph"])
        with self.cv:
            self.version += 1
            self.wanted = (self.version, args, self.box)
            self.cv.notify_all()

    def work(self):
        """The worker thread: draws the latest settings render() left, one at a time."""
        while True:
            with self.cv:
                self.cv.wait_for(lambda: self.wanted or not self.running)
                if not self.running:
                    return
                (version, args, box), self.wanted, self.busy = self.wanted, None, True
            try:
                done, failure = self.build(version, args, box), None
            except SystemExit as e:  # a theme kitten does not know, chafa failing: shown, not fatal
                done, failure = None, str(e.code)
            except Exception as e:  # anything else is shown too: the worker has to stay, or export waits for good
                done, failure = None, f"render failed: {e}"
            with self.cv:
                if done:
                    self.done = done
                else:
                    self.failure, self.message = (version, failure), failure
                self.busy = False
                self.cv.notify_all()
            try:
                os.write(self.player.remote_w, b"x")  # wakes poll() to draw it
            except BlockingIOError:  # wake-ups already pending: one is enough
                pass

    def stop(self):
        with self.cv:
            self.running = False
            self.cv.notify_all()

    def build(self, version, args, box):
        """The cells for args, and the preview: those cells drawn by Style.scaled at the size
        kitty shows them in box, RGBX pixels (a uint32 array). Runs on the worker thread."""
        # the Style (theme, font, layout, its glyph tiles) only changes with these; level and
        # contrast are read at draw time, so stepping them reuses it
        key = (args.bold, args.mono, args.theme, args.width, args.height, args.columns, args.saturation, args.skin,
               args.fit, args.crop, args.glyphs)
        source = self.crop(args)
        if self.style_key != key:
            self.style, self.style_key = self.convert.Style(args, source.size), key
        style = self.style
        style.args.level, style.args.contrast = args.level, args.contrast
        grid = style.art(self.shrink(args, style.cols))
        if style.rows is None:  # once per Style: layout scales the font from its 20 px start
            style.layout(len(grid))
        w, h = style.size()
        scale = min(box[0] / w, box[1] / h, 1) if box else 1
        if self.twin_key != (key, scale):
            self.twin, self.twin_key = style.scaled(scale), (key, scale)
        px = self.twin.paint_array(grid)
        return {"version": version, "args": copy.copy(args), "size": (w, h), "cols": style.cols,
                "preview": (px.shape[1], px.shape[0], px)}

    def crop(self, args):
        """The picture cropped (ascii-convert's --crop), kept by crop."""
        crop = args.crop
        if crop not in self.cropped:
            self.cropped[crop] = self.convert.crop(self.picture, args)
        return self.cropped[crop]

    def shrink(self, args, cols):
        """The cropped picture at chafa's sampling width for cols, once per crop and width."""
        width = cols * CELL_PX
        key = (args.crop, width)
        if key not in self.shrunk:
            picture = self.crop(args)
            if picture.width > width:
                picture = picture.resize((width, max(1, round(picture.height * width / picture.width))), self.Image.BOX)
            self.shrunk[key] = picture
        return self.shrunk[key]

    RATIOS = [("free", None), ("original", 0), ("1:1", 1), ("4:5", 4 / 5), ("5:4", 5 / 4), ("3:4", 3 / 4),
              ("4:3", 4 / 3), ("2:3", 2 / 3), ("3:2", 3 / 2), ("9:16", 9 / 16), ("16:9", 16 / 9), ("21:9", 21 / 9)]

    def crop_px(self):
        """The crop window in the picture's px, (x, y, w, h) floats, maybe past its borders."""
        v, (W, H) = self.values, self.picture.size
        return W * v["cropx"] / 100, H * v["cropy"] / 100, W * v["cropw"] / 100, H * v["croph"] / 100

    def set_crop_px(self, x, y, w, h):
        v, (W, H) = self.values, self.picture.size
        w, h = max(w, W * 0.02), max(h, H * 0.02)
        v["cropx"], v["cropy"] = round(x / W * 100, 2), round(y / H * 100, 2)
        v["cropw"], v["croph"] = round(w / W * 100, 2), round(h / H * 100, 2)

    def apply_ratio(self):
        """Reshape the crop to the chosen ratio about its centre: the largest window of that
        shape inside the current one."""
        name, ratio = self.RATIOS[self.ratio]
        if ratio is None:
            return
        x, y, w, h = self.crop_px()
        ratio = ratio or self.picture.width / self.picture.height
        cx, cy = x + w / 2, y + h / 2
        w, h = (h * ratio, h) if w / h > ratio else (w, w / ratio)
        self.set_crop_px(cx - w / 2, cy - h / 2, w, h)

    def crop_key(self, k):
        """A crop editor key, moving and shaping the window (keys: the module docstring)."""
        x, y, w, h = self.crop_px()
        W, H = self.picture.size
        moves = {b"h": (-0.05, 0), b"l": (0.05, 0), b"k": (0, -0.05), b"j": (0, 0.05),
                 b"H": (-0.01, 0), b"L": (0.01, 0), b"K": (0, -0.01), b"J": (0, 0.01),
                 b"\x1b[D": (-0.05, 0), b"\x1b[C": (0.05, 0), b"\x1b[A": (0, -0.05), b"\x1b[B": (0, 0.05)}
        free = self.RATIOS[self.ratio][1] is None
        if k in (b"\n", b"\r", b"q", b"\x1b"):
            self.cropping, self.crop_view, self.shown = False, None, None
            self.render()
            return None
        if k in moves:
            dx, dy = moves[k]
            self.set_crop_px(x + dx * W, y + dy * H, w, h)
        elif k in (b"-", b"=", b"+"):
            f = 0.95 if k == b"-" else 1 / 0.95
            self.set_crop_px(x + w * (1 - f) / 2, y + h * (1 - f) / 2, w * f, h * f)
        elif k in (b"[", b"]"):
            self.ratio = (self.ratio + (1 if k == b"]" else -1)) % len(self.RATIOS)
            self.apply_ratio()
        elif free and k in (b"<", b">", b"{", b"}"):
            f = 0.95 if k in (b"<", b"{") else 1 / 0.95
            if k in (b"<", b">"):
                self.set_crop_px(x + w * (1 - f) / 2, y, w * f, h)
            else:
                self.set_crop_px(x, y + h * (1 - f) / 2, w, h * f)
        elif k == b"c":
            self.set_crop_px((W - w) / 2, (H - h) / 2, w, h)
        elif k == b"0":
            self.ratio = 1
            self.set_crop_px(0, 0, W, H)
        return None

    def crop_canvas(self, box):
        """The crop editor's picture, box (w, h) px: the source as it is, dimmed outside the
        crop, with room around it, so the window can be moved past its borders, and the
        window's edge and thirds drawn on top. The view takes in the picture with a quarter of
        its size free on every side, and the crop wherever it is."""
        from PIL import ImageDraw

        x, y, w, h = self.crop_px()
        W, H = self.picture.size
        left, top = min(-W * 0.25, x - W * 0.05), min(-H * 0.25, y - H * 0.05)
        right, bottom = max(W * 1.25, x + w + W * 0.05), max(H * 1.25, y + h + H * 0.05)
        scale = min(box[0] / (right - left), box[1] / (bottom - top))
        size = (max(1, round((right - left) * scale)), max(1, round((bottom - top) * scale)))
        key = (round(scale, 5), self.picture.size)
        if not hasattr(self, "_crop_src") or self._crop_src[0] != key:
            shown = self.picture.resize((max(1, round(W * scale)), max(1, round(H * scale))), self.Image.BILINEAR)
            dim = self.Image.eval(shown, lambda c: c * 2 // 5)
            self._crop_src = (key, shown, dim)
        _, shown, dim = self._crop_src
        canvas = self.Image.new("RGB", size, (24, 24, 24))
        at = (round(-left * scale), round(-top * scale))
        canvas.paste(dim, at)
        box_px = [round((x - left) * scale), round((y - top) * scale), round((x + w - left) * scale), round((y + h - top) * scale)]
        inner = (max(box_px[0], at[0]), max(box_px[1], at[1]), min(box_px[2], at[0] + shown.width), min(box_px[3], at[1] + shown.height))
        if inner[2] > inner[0] and inner[3] > inner[1]:
            canvas.paste(shown.crop((inner[0] - at[0], inner[1] - at[1], inner[2] - at[0], inner[3] - at[1])), inner[:2])
        draw = ImageDraw.Draw(canvas)
        for n in (1, 2):  # thirds
            gx = box_px[0] + (box_px[2] - box_px[0]) * n // 3
            gy = box_px[1] + (box_px[3] - box_px[1]) * n // 3
            draw.line([(gx, box_px[1]), (gx, box_px[3])], fill=(150, 150, 150), width=1)
            draw.line([(box_px[0], gy), (box_px[2], gy)], fill=(150, 150, 150), width=1)
        draw.rectangle(box_px, outline=(248, 248, 242), width=2)
        return canvas.width, canvas.height, canvas.tobytes()

    def value_text(self, item):
        v = self.values
        w, h = self.target()
        return {
            "level": tone_label(v["level"]),
            "contrast": contrast_label(v["contrast"]),
            "density": f"{v['density']:.1f} px",
            "columns": str(self.columns()),
            "size": f"{w}x{h}" + ("" if v["custom"] else f"  ({self.SIZES[v['size']]})"),
            "theme": self.themes[v["theme"]][0],
            "bold": "on" if v["bold"] else "off",
            "mono": "on" if v["mono"] else "off",
            "saturation": f"{v['saturation']}%",
            "skin": "grey (calm)" if v["skin"] else "theme colour",
            "fit": "cover (edges cut)" if v["fit"] == "cover" else "contain (margins)",
            "glyphs": {"mixed": "mixed (shapes, dithered flats)", "density": "density (dithered)", "shape": "shape (chafa)"}[v["glyphs"]],
            "crop": f"{self.RATIOS[self.ratio][0]}, editor  (enter)",
            "cropw": f"{v['cropw']}%", "croph": f"{v['croph']}%",
            "cropx": f"{v['cropx']}%", "cropy": f"{v['cropy']}%",
        }.get(item, "")

    def nudge(self, item, step):
        """h l on the menu: a small step of the value in place. False for items with none."""
        v = self.values
        if item in self.STEPS:
            size, low, high = self.STEPS[item]
            v[item] = min(max(v[item] + size * step, low), high)
        elif item == "skin":
            v["skin"] = not v["skin"]
        elif item == "fit":
            v["fit"] = "contain" if v["fit"] == "cover" else "cover"
        elif item == "glyphs":
            v["glyphs"] = next_glyphs(v["glyphs"], step)
        elif item == "density":
            v["density"] = min(max(round(v["density"] + step), self.DENSITY[0]), self.DENSITY[1])
        elif item == "columns":
            self.set_columns(self.columns() + 10 * step)
        elif item in ("bold", "mono"):
            v[item] = not v[item]
        elif item == "size":
            v["size"], v["custom"] = (v["size"] + step) % len(self.SIZES), None
        elif item == "theme":
            v["theme"] = (v["theme"] + step) % len(self.themes)
        else:
            return False
        return True

    def commit(self, item, text):
        """A typed value, applied if it parses; False when it does not."""
        v = self.values
        try:
            if item in self.STEPS:
                _, low, high = self.STEPS[item]
                v[item] = min(max(int(text), low), high)
            elif item == "density":
                v["density"] = min(max(float(text), self.DENSITY[0]), self.DENSITY[1])
            elif item == "columns":
                self.set_columns(int(text))
            elif item == "size":
                w, h = (int(n) for n in text.lower().replace(" ", "").split("x"))
                low, high = self.convert.PX
                if not (low <= w <= high and low <= h <= high):
                    return False
                v["custom"] = (w + w % 2, h + h % 2)
        except ValueError:
            return False
        return True

    EXPORT_WAIT = 60  # seconds export() waits for the worker to finish the latest settings

    def export(self):
        """The full-size PNG for the latest settings (once the worker is done with them), from
        a Style of its own: the file ascii-convert writes with these settings. The message says
        why not when their render failed or is not done within EXPORT_WAIT."""
        with self.cv:
            self.cv.wait_for(lambda: not self.wanted and not self.busy, timeout=self.EXPORT_WAIT)
            done = self.done if self.done and self.done["version"] == self.version else None
            failure = self.failure[1] if self.failure and self.failure[0] == self.version else None
        if not done:
            self.message = f"not exported: {failure or 'still rendering'}"
            return
        args = copy.copy(done["args"])
        style = self.convert.Style(args, self.crop(args).size)
        grid = style.art(self.shrink(args, style.cols))
        style.layout(len(grid))
        style.paint(grid).save(self.out)
        self.message = f"exported {self.out.name}"

    # ---- keys

    def key(self, k):
        self.message = ""
        if self.prompt:
            return self.prompt_key(k)
        if self.list:
            return self.list_key(k)
        if self.cropping:
            return self.crop_key(k)
        item = self.items[self.at]
        if k in (b"q", b"Q", b"r", b"\x1b"):
            return "close"
        if k in (b"j", b"\x1b[B"):
            self.at = (self.at + 1) % len(self.items)
        elif k in (b"k", b"\x1b[A"):
            self.at = (self.at - 1) % len(self.items)
        elif k in (b"h", b"l", b"\x1b[D", b"\x1b[C"):
            if self.nudge(item, -1 if k in (b"h", b"\x1b[D") else 1):
                self.render()
        elif k == b"`" and item in self.MENU:
            defaults = self.defaults()
            for name in self.RESETS.get(item, (item,)):
                self.values[name] = defaults[name]
            if item == "crop":
                self.ratio = 0  # free
            self.render()
        elif k == b"s":
            self.export()
        elif k == b"/":
            self.open_list("theme", search=True)
        elif k in (b"\n", b"\r"):
            if item == "export":
                self.export()
            elif item == "back":
                return "close"
            elif item in ("bold", "mono", "skin", "fit", "glyphs"):
                self.nudge(item, 1)
                self.render()
            elif item in ("size", "theme"):
                self.open_list(item)
            elif item == "crop":
                self.cropping = True
            else:
                self.prompt = (item, "")

    def prompt_key(self, k):
        item, text = self.prompt
        if k == b"\x1b":
            self.prompt = None
        elif k in (b"\n", b"\r"):
            self.prompt = None
            if self.commit(item, text):
                self.render()
            else:
                self.message = f"not a value: {text}"
        elif k in (b"\x7f", b"\x08"):
            self.prompt = (item, text[:-1])
        elif len(k) == 1 and 32 <= k[0] < 127:
            self.prompt = (item, text + k.decode())

    def options(self):
        """The open list's rows, (label, index into its choices); a theme search filters."""
        lst = self.list
        if lst["kind"] == "size":
            return [(name, i) for i, name in enumerate(self.SIZES)] + [("custom WxH", -1)]
        q = lst["query"].lower()
        return [(name, i) for i, (name, _) in enumerate(self.themes) if not q or q in name.lower()]

    def open_list(self, kind, search=False):
        current = self.values["size" if kind == "size" else "theme"]
        self.list = {"kind": kind, "query": "", "searching": search, "at_theme": self.values["theme"]}
        rows = self.options()
        self.list["at"] = next((n for n, (_, i) in enumerate(rows) if i == current), 0)

    def list_key(self, k):
        lst = self.list
        rows = self.options()
        if lst["searching"]:
            if k in (b"\n", b"\r", b"\x1b[B", b"\x1b[A", b"\t"):
                lst["searching"] = False
                if k in (b"\n", b"\r"):
                    return None
            elif k == b"\x1b":
                lst["searching"] = False
                return None
            elif k in (b"\x7f", b"\x08"):
                lst["query"] = lst["query"][:-1]
                lst["at"] = 0
            elif len(k) == 1 and 32 <= k[0] < 127:
                lst["query"] += k.decode()
                lst["at"] = 0
            rows = self.options()
            if rows and lst["kind"] == "theme":
                lst["at"] = min(lst["at"], len(rows) - 1)
                if lst["at_theme"] != rows[lst["at"]][1]:
                    lst["at_theme"] = rows[lst["at"]][1]
                    self.render()
            if lst["searching"] or k not in (b"\x1b[B", b"\x1b[A", b"\t"):
                return None
        if k in (b"q", b"\x1b", b"h", b"\x1b[D"):
            self.list = None
            self.render()  # back to the chosen theme's preview
            return None
        if k == b"/" and lst["kind"] == "theme":
            lst["searching"] = True
            return None
        step = {b"j": 1, b"\x1b[B": 1, b"\t": 1, b"k": -1, b"\x1b[A": -1}.get(k)
        if step and rows:
            lst["at"] = (lst["at"] + step) % len(rows)
            if lst["kind"] == "theme":
                lst["at_theme"] = rows[lst["at"]][1]
                self.render()
        elif k in (b"\n", b"\r", b"l", b"\x1b[C") and rows:
            choice = rows[lst["at"]][1]
            self.list = None
            if lst["kind"] == "theme":
                self.values["theme"] = choice
            elif choice < 0:
                self.prompt = ("size", "")
                return None
            else:
                self.values["size"], self.values["custom"] = choice, None
            self.render()

    # ---- drawing

    def draw(self, cols, rows):
        w = self.WIDTH
        dim, rev, off = "\x1b[90m", "\x1b[7m", "\x1b[0m"
        px, pw, ph = w + 1, cols - w - 1, rows  # the preview's frame
        cell_w, cell_h = self.player.kitty_cell()
        box = (int((pw - 2) * cell_w), int((ph - 2) * cell_h))
        if box != self.box:  # the preview is drawn at the size it shows: a new size, a new render
            self.box = box
            self.render()
        if self.cropping:
            return self.draw_crop(cols, rows, box)
        done = self.done
        # the image goes to kitty only when there is a new one or the window changed; otherwise
        # only the text is written, over itself, and the image stays as it is
        place = done and self.shown != (done["version"], cols, rows)
        out = [b"\x1b[?2026h"]
        if place or not self.shown or self.shown[1:] != (cols, rows):
            out += [KITTY_CLEAR, b"\x1b[2J\x1b[0m"]
            place = bool(done)
        lines = []
        if self.list:
            lst = self.list
            title = "Size" if lst["kind"] == "size" else "Theme  (dark, kitty's)"
            lines += [f" {title}", ""]
            options = self.options()
            room = max(3, rows - 8)
            first = min(max(0, lst["at"] - room // 2), max(0, len(options) - room))
            for n, (label, i) in enumerate(options[first : first + room], start=first):
                mark = ">" if n == lst["at"] else " "
                text = f" {mark} {label}"
                if lst["kind"] == "theme":  # reverse video on the name only: it would hide the swatch's blocks
                    name = f" {mark} {label[: w - 22]:<{w - 22}}"
                    lines.append(((rev + name + off) if n == lst["at"] else name) + " " + swatch(self.themes[i][1]))
                else:
                    text = text[: w - 1].ljust(w - 1)
                    lines.append((rev + text + off) if n == lst["at"] else text)
            lines.append("")
            if lst["kind"] == "theme":
                lines.append(f" /{lst['query']}_" if lst["searching"] else f" {dim}/ search   j k move   enter pick   esc back{off}")
                lines.append(f" {dim}{len(options)} themes{off}")
            else:
                lines.append(f" {dim}j k move   enter pick   esc back{off}")
        else:
            lines += [" Render", f" {dim}{self.out.name}{off}", ""]
            for n, item in enumerate(self.items):
                if item == self.ACTIONS[0]:
                    lines += ["", f" {dim}{'─' * (w - 3)}{off}"]
                label = self.LABELS[item]
                text = f" {'>' if n == self.at else ' '} {label:<10} {self.value_text(item)}"[: w - 1].ljust(w - 1)
                lines.append((rev + text + off) if n == self.at else text)
            lines += ["", f" {dim}j k move   h l nudge   enter set   ` default{off}",
                      f" {dim}s export   / theme search   q back{off}"]
        if self.prompt:
            item, text = self.prompt
            span = lambda setting: "%d..%d" % LIMITS[setting]
            hint = {"level": span("level") + ", up darker", "contrast": span("contrast"),
                    "density": f"px {self.DENSITY[0]}..{self.DENSITY[1]}", "columns": "%d..%d" % self.convert.COLUMNS,
                    "size": "WxH, each %d..%d" % self.convert.PX, "saturation": "percent, " + span("saturation"),
                    "cropw": "% of picture width", "croph": "% of picture height",
                    "cropx": "% from the left edge", "cropy": "% from the top edge"}.get(item, "")
            lines += ["", f" {self.LABELS[item]} ({hint}): {text}_"]
        if self.message:
            lines += ["", f" {self.message}"[: w - 1]]
        out += self.menu(lines, rows)
        # the preview, in a frame of its own
        if pw > 10 and done:
            out += self.frame(px, pw, ph, f" {done['size'][0]}x{done['size'][1]} · {done['cols']} columns ")
            if place:
                out.append(self.player.kitty_pixels(*done["preview"], 32, px + 1, 2, pw - 2, ph - 2))
                self.shown = (done["version"], cols, rows)
        out.append(b"\x1b[?2026l")
        return b"".join(out)

    def draw_crop(self, cols, rows, box):
        """The crop editor's screen: its numbers and keys on the left, the source with the crop
        window on the right, re-sent whenever the window moves."""
        w = self.WIDTH
        dim, off = "\x1b[90m", "\x1b[0m"
        px, pw, ph = w + 1, cols - w - 1, rows
        x, y, cw, ch = self.crop_px()
        v = self.values
        lines = [" Crop", f" {dim}the source; the bright frame is the crop{off}", "",
                 f"   Ratio      {self.RATIOS[self.ratio][0]}",
                 f"   X          {v['cropx']:g}%   ({round(x)} px)",
                 f"   Y          {v['cropy']:g}%   ({round(y)} px)",
                 f"   W          {v['cropw']:g}%   ({round(cw)} px)",
                 f"   H          {v['croph']:g}%   ({round(ch)} px)", "",
                 f" {dim}h j k l    move (H J K L finer){off}",
                 f" {dim}- =        smaller, larger{off}",
                 f" {dim}[ ]        ratio{off}",
                 f" {dim}< > {{ }}    width, height (free){off}",
                 f" {dim}c centre   0 whole picture{off}",
                 f" {dim}enter q    back to the menu{off}"]
        out = [b"\x1b[?2026h"]
        key = (v["cropx"], v["cropy"], v["cropw"], v["croph"], cols, rows)
        if self.crop_view is None or self.crop_view != key:
            out += [KITTY_CLEAR, b"\x1b[2J\x1b[0m"]
            out += self.frame(px, pw, ph, " source · crop " + f"{round(cw)}x{round(ch)} ")
            out.append(self.player.kitty_pixels(*self.crop_canvas(box), 24, px + 1, 2, pw - 2, ph - 2))
            self.crop_view = key
            self.shown = None  # back in the menu, the preview goes up again
        out += self.menu(lines, rows)
        out.append(b"\x1b[?2026l")
        return b"".join(out)

    def menu(self, lines, rows):
        """lines down the menu column from the top row, each padded to its width, the rows
        under them blank: every row written in full, so what was there goes."""
        lines = lines + [""] * (rows - len(lines))
        return [b"\x1b[%d;1H%s%s" % (i + 1, line.encode(), b" " * max(0, self.WIDTH - len(SGR_TEXT.sub("", line))))
                for i, line in enumerate(lines[:rows])]

    def frame(self, px, pw, ph, title):
        """The preview's frame, dim: pw x ph cells from column px of the top row, title centred
        in its top edge."""
        dim, off = "\x1b[90m", "\x1b[0m"
        out = [b"\x1b[1;%dH%s%s%s" % (px, dim.encode(), ("┌" + title.center(pw - 2, "─")[: pw - 2] + "┐").encode(), off.encode())]
        for r in range(2, ph):
            out.append(f"\x1b[{r};{px}H{dim}│\x1b[{r};{px + pw - 1}H│{off}".encode())
        out.append(b"\x1b[%d;%dH%s%s%s" % (ph, px, dim.encode(), ("└" + "─" * (pw - 2) + "┘").encode(), off.encode()))
        return out


class Player:
    def __init__(self, path):
        # a still, upright and full size, or None; MEDIA skips Pillow (its plugins take ~90 ms)
        try:
            self.show(path, None if Path(path).suffix.lower() in MEDIA else open_picture(path))
        except TooLarge as e:
            sys.exit(f"ascii-viewer: {e}")
        self.pixels = bool(self.picture) and kitty_terminal()  # v: the image itself over the kitty protocol instead of ASCII
        self.kitty = (None, b"")  # cut()'s (what, (w, h, RGB)) for the last image scaled for kitty
        self.placed = None  # where that image is on screen, while it is (kitty_place)
        self.rendered = None  # (frame, look, Term.render's) of the last ASCII picture
        self.jobs = None  # part()'s queue to render_parts(), once an SVG zoom has asked for one
        self.still = self.picture is not None  # the mode: a still image (kept on the empty folder's screen)
        self.decoder = None
        if self.still:
            self.fps, self.has_audio, self.length = Fraction(1), False, math.inf
        else:
            container, video, self.has_audio, self.length = probe(path)
            self.fps = play_rate(video) if video else None
            if video:
                self.decoder = Decoder(container, video, self.fps)
            else:
                container.close()
        self.has_video = self.fps is not None
        self.period = 1 / float(self.fps or 1)  # seconds a frame shows
        self.scope = None  # the oscilloscope process, for audio without video
        self.loop = False
        self.state = STOPPED
        self.proc = None
        self.frame = None
        self.n = 0  # frames read since the last start
        self.history = OrderedDict()  # frame index -> frame, the last HISTORY shown (frame_step)
        self.held = None  # frame index shown from the history, while the decoder is ahead of it
        self.base = 0.0  # media time of the first frame since the last start
        self.level, self.contrast, self.lut = 0, 0, None  # percents, and their tone_table (ascii_theme)
        self.bold = False  # b: glyphs in the font's bold face
        self.mono = False  # c: the theme's brightest colour only
        self.glyphs = "mixed"  # g: ascii_density's mode: mixed, density or shape
        self.saturation = 100  # 7 8: percent, how much colour a cell needs to take a hue (ascii_theme)
        self.term = Term(theme())
        self.page = None  # r: the render page (RenderPage) while it is open
        self.help = None  # F1: the first line shown of the keys, while they show
        self.speed = 100  # percent
        self.muted = False
        self.volume = None  # mpv's, known once its first run has started
        self.toast, self.toast_until = "", 0.0
        self.trashed = []  # d: the Trashed files u puts back, the last on top; this run's only
        self.listing = None  # ((folder, its mtime), sibling_images) of the folder last listed
        self.stale = 0  # what the next flush() draws: 0 nothing, 1 the screen, 2 cleared first
        self.audio = None  # the mpv process, while it plays
        self.ipc = None  # its JSON IPC stream
        self.sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"ascii-viewer-{os.getpid()}.sock")
        for old in Path(self.sock).parent.glob("ascii-viewer-*.sock"):  # left by runs killed outright
            if not Path(f"/proc/{old.stem.removeprefix('ascii-viewer-')}").exists():
                old.unlink(missing_ok=True)
        # The clock reads pos + (now - mark) * speed while running; mpv's time-pos sets both
        self.pos, self.mark, self.running = 0.0, 0.0, False
        self.geometry = None  # the window's (cols, rows, cell w, cell h) once window() has measured it
        # SIGWINCH may land inside a draw's own write, so it only wakes poll() through a pipe
        self.winch, w = os.pipe()
        os.set_blocking(w, False)
        signal.set_wakeup_fd(w)
        signal.signal(signal.SIGWINCH, lambda *_: None)
        # MPRIS requests arrive on a D-Bus thread and wait in a queue for the main loop
        self.requests = deque()
        self.remote_r, self.remote_w = os.pipe()
        os.set_blocking(self.remote_w, False)

    def start(self, at=0.0):
        """Play from at seconds: a decoder seek and a fresh mpv, so every start is the same."""
        self.halt()
        self.start_video(at)
        self.running = True
        self.state = PLAYING
        if self.has_audio:
            self.start_audio(at)

    def start_video(self, at):
        """The decoder from at seconds (none for audio alone), and the clock set there."""
        if self.decoder:
            self.proc = self.decoder.seek(at)
        self.n = 0
        self.base = self.pos = at
        self.mark = time.monotonic()

    def halt(self):
        """Stop everything and freeze the clock where it is."""
        if self.running:
            self.pos = self.position()
            self.running = False
        self.proc = None
        self.stop_audio()
        self.state = STOPPED

    def launch_mpv(self, at, *options, **popen):
        """Start mpv at the given second with the shared settings and its IPC socket. True once
        the socket answers."""
        command = [
            "mpv", "--audio-pitch-correction=no", f"--input-ipc-server={self.sock}",
            f"--start={at}", f"--speed={self.speed / 100}", *options,
        ]
        if self.volume is not None:
            command.append(f"--volume={self.volume}")
        if self.muted:
            command.append("--mute=yes")
        env = {**os.environ, "PIPEWIRE_PROPS": f"{{ node.name = {STREAM} }}"}
        self.audio = subprocess.Popen([*CHILD, *command, "--", self.path], env=env, **popen)
        end = time.monotonic() + 5
        while self.audio.poll() is None and time.monotonic() < end:
            self.ipc = self.connect()  # None until mpv has made the socket
            if self.ipc:
                return True
            time.sleep(0.02)
        self.stop_audio()
        return False

    def start_audio(self, at):
        """Start a headless mpv and wait until its clock runs (else the video plays silent)."""
        quiet = subprocess.DEVNULL
        loop = ["--loop-file=inf"] if self.loop and not self.has_video else []  # video loops by restart
        if not self.launch_mpv(
            at, "--vid=no", "--no-terminal", *loop,
            stdin=quiet, stdout=quiet, stderr=quiet, start_new_session=True,
        ):
            return
        end = time.monotonic() + 5
        while self.audio.poll() is None and time.monotonic() < end:
            if (r := self.mpv("get_property", "time-pos")) and r["error"] == "success":
                self.read_volume()
                return
            time.sleep(0.02)
        self.stop_audio()

    def read_volume(self):
        r = self.mpv("get_property", "volume")
        if r and r["error"] == "success":
            self.volume = r["data"]

    def connect(self):
        s = socket.socket(socket.AF_UNIX)
        try:
            s.connect(self.sock)
        except OSError:
            s.close()
            return None
        f = s.makefile("rwb")
        s.close()
        return f

    def mpv(self, *command):
        """mpv's reply to a command, a dict with "error" and "data"; None once mpv is gone."""
        if not self.ipc:
            return None
        try:
            reply = ask(self.ipc, *command)
        except OSError:
            reply = None
        if reply is None:
            close(self.ipc)
            self.ipc = None
        return reply

    def stop_audio(self):
        if self.ipc:
            close(self.ipc)
            self.ipc = None
        if self.audio:
            self.audio.kill()
            self.audio.wait()
            self.audio = None
        try:
            os.unlink(self.sock)
        except FileNotFoundError:
            pass

    def clock(self):
        """Media time in seconds as last read from mpv, carried on by the local clock."""
        return self.pos + ((time.monotonic() - self.mark) * self.speed / 100 if self.running else 0)

    def position(self):
        """Media time in seconds: mpv's audio clock while it answers, else the local one."""
        if self.running and self.ipc:
            r = self.mpv("get_property", "time-pos")
            if r and r["error"] == "success":
                self.pos, self.mark = r["data"], time.monotonic()
        return self.clock()

    def pause(self):
        self.pos = self.position()
        self.running = False
        self.state = PAUSED
        if self.ipc:
            self.mpv("set_property", "pause", True)

    def resume(self):
        if self.ipc:
            self.mpv("set_property", "pause", False)
        self.mark = time.monotonic()
        self.running = True
        self.state = PLAYING

    def seek(self, delta):
        self.seek_to(self.position() + delta)

    def seek_to(self, at):
        """Move to at seconds. A paused player shows the new frame, held.
        A running mpv seeks in place over IPC, which takes milliseconds, and the decoder seeks;
        otherwise (stopped, silent, or mpv's audio already over) everything starts afresh."""
        at = min(max(at, 0.0), self.length)
        self.held = None
        paused = self.state == PAUSED
        r = self.mpv("seek", at, "absolute", "exact") if self.state != STOPPED else None
        if r and r["error"] == "success":
            self.start_video(at)
        else:
            self.start(at)
        if paused:
            if self.proc:
                self.frame = self.proc.read() or self.frame
                self.n = 1
            self.pause()

    def frame_step(self, frames):
        """mpv's . and ,: one frame forward or back, then held, paused; mpv follows. The
        decoder reads forwards only, and a frame before its position takes a re-seek, whose
        cost depends on the GOP (35-600 ms measured on 1080p30): so the last HISTORY frames
        shown are kept, stepping back through them is instant, and past them one re-seek
        decodes BACKFILL frames up to the wanted one. Forward takes held frames up to the
        decoder's position, then reads on."""
        if not self.proc:
            return
        if self.state == PLAYING:
            self.pause()
        head = self.index(self.frame_time())  # the decoder's last frame
        at = self.held if self.held is not None else head
        want = at + (1 if frames > 0 else -1)
        if want < 0:
            return
        if frames > 0 and self.held is None:
            frame = self.proc.read()
            if frame is None:  # the last frame is already on screen
                return
            self.frame, self.n = frame, self.n + 1
            self.remember(want, frame)
        elif want in self.history:
            self.frame = self.history[want]
            self.held = None if want == head else want
        elif frames < 0:  # before the history: decode a run of frames up to want
            start = max(0, want - BACKFILL + 1)
            self.start_video(start * self.period)
            for i in range(start, want + 1):
                frame = self.proc.read()
                if frame is None:
                    break
                self.frame, self.n = frame, self.n + 1
                self.remember(i, frame)
            self.held = None
        else:
            return self.seek_to(want * self.period)
        self.pos = want * self.period
        if self.ipc:
            self.mpv("seek", self.pos, "absolute", "exact")

    def index(self, seconds):
        return round(seconds * float(self.fps))

    def advance(self):
        """The decoder's next frame on screen, counted and kept for stepping back (frame_step);
        its media time, None at the end."""
        frame = self.proc.read()
        if frame is None:
            return None
        self.frame, self.n = frame, self.n + 1
        at = self.frame_time()
        self.remember(self.index(at), frame)
        return at

    def remember(self, i, frame):
        self.history[i] = frame
        self.history.move_to_end(i)
        while len(self.history) > HISTORY:
            self.history.popitem(last=False)

    def set_speed(self, percent):
        self.pos, self.mark = self.position(), time.monotonic()  # settle the clock at the old speed
        self.speed = min(max(percent, 25), 400)
        if self.ipc:
            self.mpv("set_property", "speed", self.speed / 100)

    def set_volume(self, step):
        if self.ipc and self.mpv("add", "volume", step):  # mpv keeps it within 0 and volume-max
            self.read_volume()

    def serve_mpris(self):
        """Export an MPRIS player on the session bus, so playerctl can drive this one. MPRIS is
        a bonus: without PyGObject the player just has no D-Bus side."""
        global Gio, GLib
        try:
            import gi

            gi.require_version("Gio", "2.0")
            from gi.repository import Gio, GLib
        except (ImportError, ValueError):
            return

        def serve():
            try:
                conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
                for info in Gio.DBusNodeInfo.new_for_xml(MPRIS_XML).interfaces:
                    conn.register_object_with_closures2("/org/mpris/MediaPlayer2", info, self.mpris_call, self.mpris_get, None)
                Gio.bus_own_name_on_connection(
                    conn, f"org.mpris.MediaPlayer2.ascii-viewer.instance{os.getpid()}",
                    Gio.BusNameOwnerFlags.NONE, None, None,
                )
            except GLib.Error:  # no session bus, so nobody could call anyway
                return
            GLib.MainLoop().run()

        threading.Thread(target=serve, daemon=True).start()

    def mpris_call(self, conn, sender, path, iface, method, params, invocation):
        """A request from the D-Bus thread, queued for the main loop."""
        self.requests.append((method, params.unpack()))
        os.write(self.remote_w, b"x")
        invocation.return_value(None)

    def mpris_get(self, conn, sender, path, iface, name):
        """One MPRIS property, as the D-Bus thread's reply."""
        V = GLib.Variant
        fixed = {
            "CanQuit": ("b", True), "CanRaise": ("b", False), "HasTrackList": ("b", False),
            "Identity": ("s", "ascii-viewer"), "SupportedUriSchemes": ("as", ["file"]),
            "SupportedMimeTypes": ("as", []), "LoopStatus": ("s", "Track" if self.loop else "None"),
            "Rate": ("d", self.speed / 100), "Shuffle": ("b", False),
            "Volume": ("d", (self.volume or 100) / 100), "MinimumRate": ("d", 0.25),
            "MaximumRate": ("d", 4.0), "CanGoNext": ("b", False), "CanGoPrevious": ("b", True),
            "CanPlay": ("b", True), "CanPause": ("b", True), "CanSeek": ("b", True),
            "CanControl": ("b", True),
        }
        if name in fixed:
            return V(*fixed[name])
        if name == "PlaybackStatus":
            return V("s", {PLAYING: "Playing", PAUSED: "Paused", STOPPED: "Stopped"}[self.state])
        if name == "Position":
            return V("x", int(self.clock() * 1e6))
        meta = {
            "mpris:trackid": V("o", "/org/mpris/MediaPlayer2/Track/1"),
            "xesam:title": V("s", os.path.basename(self.path)),
            "xesam:url": V("s", Path(self.path).resolve().as_uri()),
        }
        if self.length != math.inf:
            meta["mpris:length"] = V("x", int(self.length * 1e6))
        return V("a{sv}", meta)

    def remote(self):
        """Run the MPRIS requests that arrived since the last look (dropped on the render page,
        where a wake-up is its worker with a new preview)."""
        if self.page:
            self.requests.clear()
            return self.draw()
        while self.requests:
            method, args = self.requests.popleft()
            playing = self.state == PLAYING
            if method == "PlayPause" or (method == "Play" and not playing) or (method == "Pause" and playing):
                self.key(b" ")
            elif method == "Seek":
                self.seek(args[0] / 1e6)
            elif method == "SetPosition":
                self.seek(args[1] / 1e6 - self.position())
            elif method == "Previous":
                self.seek(-self.position())
            elif method == "Stop":
                self.halt()
            elif method == "Quit":
                sys.exit(0)
        self.redraw()

    def set_mute(self, muted):
        self.muted = muted
        if self.ipc:
            self.mpv("set_property", "mute", muted)

    def fullscreen(self):
        """Toggle Hyprland fullscreen on the window this runs in: the client whose pid is one
        of this process's ancestors (the kitty), by address, not the focused window, which can
        change between the key and the dispatch."""
        try:
            clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
        except (OSError, ValueError):
            return
        by_pid = {c["pid"]: c["address"] for c in clients}
        pid = os.getpid()
        while pid > 1 and pid not in by_pid:
            try:
                pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
            except (OSError, ValueError, IndexError):
                return
        if pid in by_pid:
            window = f'address:{by_pid[pid]}'
            subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.fullscreen({{ mode = "fullscreen", window = "{window}" }})'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def screenshot(self):
        """s: the picture on screen saved by ascii-convert with this player's look, beside the
        file as out_name names it, in a background thread; a toast says when it is there. A
        video's is the source frame at the time shown (--at), a still's the whole picture as
        turned, whatever the zoom."""
        at = None if self.still else self.shown_time()
        out = Path(convert_module().out_name(self.path, at))
        look = self.convert_args()
        self.say("screenshot ...")

        source, turned = Path(self.path), None
        # ascii-convert sees the file as stored, transparency over the theme's background: hand
        # it the turned image, or the picture over the grey the ASCII view shows
        if self.still and (self.rotation or self.picture.mode == "RGBA"):
            turned = flatten(self.turned(), GREY)

        def work():
            with tempfile.TemporaryDirectory() as tmp:
                src = source
                if turned:
                    src = Path(tmp, source.stem + ".png")
                    turned.save(src)
                r = subprocess.run(
                    [*CHILD, CONVERT, *([] if at is None else ["--at", str(at)]), *look, "--output", str(out), str(src)],
                    capture_output=True, stdin=subprocess.DEVNULL, start_new_session=True,
                )
            self.say(f"saved {out.name}" if r.returncode == 0 else "screenshot failed")
            os.write(self.remote_w, b"x")  # wakes the main loop to draw the toast

        threading.Thread(target=work, daemon=True).start()

    def convert_args(self):
        """The look as ascii-convert's options: what s hands it, and what the render page opens on."""
        return ["--level", str(self.level), "--contrast", str(self.contrast), "--saturation", str(self.saturation),
                "--glyphs", self.glyphs, *(["--bold"] if self.bold else []), *(["--mono"] if self.mono else [])]

    def copy_image(self):
        """y: the image itself to the clipboard (original_png), in a background thread. wl-copy
        forks to serve the clipboard and outlives this process, so not under CHILD."""
        path, rotation = self.path, self.rotation
        self.say("copying ...")

        def work():
            try:
                data, (w, h) = original_png(path, rotation)
                r = subprocess.run(["wl-copy", "--type", "image/png"], input=data, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
                self.say(f"copied {w}x{h}" if r.returncode == 0 else "copy failed")
            except TooLarge:  # an SVG that declares a size over the limit
                self.say("too large to copy")
            except (OSError, ValueError):
                self.say("copy failed")
            os.write(self.remote_w, b"x")  # wakes the main loop to draw the toast

        threading.Thread(target=work, daemon=True).start()

    def show(self, path, picture):
        """Make picture (open_picture's of path) the still on screen: unturned, at the fit."""
        self.path, self.picture = path, picture
        self.logical = picture.size if picture else None  # its size at the first raster: zoom is measured in this
        self.rotation = 0  # quarter turns clockwise, the image's Up and Down keys
        self.turns = (None, 0, None)  # (picture, rotation, picture turned) of the last turn
        self.cut = None  # (key, frame) of the last ASCII frame
        self.empty = None  # the folder (a Path) once its last image is gone: nothing to show, picture None
        self.confirming = False  # D asked: the status row waits for y
        self.pending = None  # h l not acted on yet: (images, index of the image shown, steps), for flush() (settle_step)
        self.detail = None  # (what, image or None) of the last SVG part rendered (part())
        self.asked = None  # the what of the last part asked for
        self.reset_view()

    def reset_view(self):
        """The fit, centred: a new image (show) and a turn (rotate) start here."""
        self.zoom_n = 0  # zoom steps in, each a factor of 2^0.5; 0 is the fit
        self.pan = (0.5, 0.5)  # the view's centre, as fractions of the turned image

    def turned(self):
        """The picture turned as on screen, kept while neither changes."""
        if not self.rotation:
            return self.picture
        if self.turns[0] is not self.picture or self.turns[1] != self.rotation:
            self.turns = (self.picture, self.rotation, self.picture.rotate(-90 * self.rotation, expand=True))
        return self.turns[2]

    def extent(self):
        """The turned image's (width, height) at the logical size."""
        w, h = self.logical
        return (h, w) if self.rotation % 2 else (w, h)

    def window(self):
        """The window as (cols, rows, cell width, cell height): its cells, and a cell's size in
        px from TIOCGWINSZ, 9 x 20 when it does not say. One snapshot, so a draw and the keys
        around it all see one size; poll() takes it again on SIGWINCH."""
        if self.geometry is None:
            cols, rows = shutil.get_terminal_size()
            try:
                _, _, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
            except OSError:
                xpx = ypx = 0
            self.geometry = (cols, rows, *((xpx / cols, ypx / rows) if xpx and ypx else (9, 20)))
        return self.geometry

    def viewport(self):
        """The picture's room in px: the whole window (the status goes over its last row)."""
        cols, rows = self.window()[:2]
        cell_w, cell_h = self.kitty_cell()
        return cols * cell_w, rows * cell_h

    def fit_scale(self):
        """Screen px per image px at the fit: the picture fills the window, never enlarged."""
        w, h = self.extent()
        room_w, room_h = self.viewport()
        return min(room_w / w, room_h / h, 1)

    def zoom_limit(self):
        """The most zoom steps: where one image pixel covers ZOOM_MAX_PX screen pixels. The fit
        never enlarges (scale <= 1), so there are always 6 steps or more."""
        return int(2 * math.log2(ZOOM_MAX_PX / self.fit_scale()) + 1e-9)

    def steps(self):
        """The zoom steps in force: zoom_n within the window's limit. A bigger window raises
        the scale of a step, so a count kept from a smaller one can be over it."""
        return min(self.zoom_n, self.zoom_limit())

    def scale(self, n=None):
        """Screen px per image px at n zoom steps (now by default)."""
        return self.fit_scale() * 2 ** ((self.steps() if n is None else n) / 2)

    def crop_box(self, n=None):
        """The visible part of the turned image as (left, top, right, bottom) in logical px at
        n zoom steps (now by default): the window's room at the zoom's scale, around the pan,
        kept inside the image; an axis the image does not fill is shown whole."""
        w, h = self.extent()
        n = self.steps() if n is None else n
        if not n:
            return 0.0, 0.0, float(w), float(h)
        room_w, room_h = self.viewport()
        s = self.scale(n)
        bw, bh = min(w, room_w / s), min(h, room_h / s)
        cx = min(max(self.pan[0] * w, bw / 2), w - bw / 2)
        cy = min(max(self.pan[1] * h, bh / 2), h - bh / 2)
        return cx - bw / 2, cy - bh / 2, cx + bw / 2, cy + bh / 2

    def settle(self):
        """Keep the view's centre as it is shown, inside the image."""
        left, top, right, bottom = self.crop_box()
        w, h = self.extent()
        self.pan = ((left + right) / 2 / w, (top + bottom) / 2 / h)

    def zoom_by(self, steps):
        """+ and -: zoom in or out about the view's centre, between the fit and the limit; the
        toast gives screen px per image px as a percent (an SVG's image px are its first
        raster's, 1600 px wide). In ASCII, steps whose view is still the whole image are passed
        over: chafa fills the cells either way, so they would change nothing."""
        limit = self.zoom_limit()
        n = self.steps() + steps
        w, h = self.extent()
        while not self.pixels and 0 < n <= limit and self.crop_box(n) == (0.0, 0.0, float(w), float(h)):
            n += steps
        self.zoom_n = self.steps() if n > limit else max(n, 0)
        self.settle()
        self.say("fit" if not self.zoom_n else f"zoom {round(self.scale() * 100)}%")
        self.redraw(clear=True)

    def pan_by(self, dx, dy):
        """Zoomed in: move the view dx of its width and dy of its height."""
        left, top, right, bottom = self.crop_box()
        w, h = self.extent()
        self.pan = (((left + right) / 2 + dx * (right - left)) / w, ((top + bottom) / 2 + dy * (bottom - top)) / h)
        self.settle()
        self.redraw(clear=True)

    def visible(self):
        """(the turned picture, the visible box in its px): what is drawn, in either mode. The
        picture is at the logical size: an SVG's first raster, never replaced (part())."""
        picture = self.turned()
        left, top, right, bottom = self.crop_box()
        return picture, (max(left, 0), max(top, 0), min(right, picture.width), min(bottom, picture.height))

    def part(self, box, scale):
        """An SVG drawn larger than its first raster (scale px per logical px over 1): box (logical
        px, as turned) rasterized alone at its size, as (what, image) once render_parts() has it;
        till then None, and the raster shows enlarged. A part costs what its size does, at any zoom."""
        if scale <= 1 or not is_svg(self.path):
            return None
        size = (max(1, round((box[2] - box[0]) * scale)), max(1, round((box[3] - box[1]) * scale)))
        what = (self.path, self.rotation, tuple(round(v, 2) for v in box), size)
        if self.detail and self.detail[0] == what:
            return self.detail if self.detail[1] else None  # None: resvg failed, the raster stays
        if self.asked != what:
            self.asked = what
            if self.jobs is None:
                self.jobs = queue.SimpleQueue()
                threading.Thread(target=self.render_parts, daemon=True).start()
            self.jobs.put((what, self.logical))
        return None

    def render_parts(self):
        """part()'s background renders: the newest job only (keys held meanwhile asked for more),
        each told to poll() through remote_w, which draws it."""
        while True:
            job = self.jobs.get()
            while not self.jobs.empty():
                job = self.jobs.get()
            (path, rotation, box, size), logical = job
            try:
                image = svg_part(path, logical, rotation, box, size)
                image.load()
            except (OSError, ValueError):
                image = None
            self.detail = (job[0], image)
            try:
                os.write(self.remote_w, b"x")
            except BlockingIOError:  # the pipe full: poll() has a wake-up waiting already
                pass

    def thumbnail(self):
        """The visible part of the (turned) still image as a frame: (w, h, rgb) fitted to
        MAX_W x MAX_H, transparency over grey. Kept until the picture or the view changes. A
        zoomed SVG is drawn as fine as chafa samples it (CELL_PX a cell side) within the frame."""
        picture, box = self.visible()
        w, h = box[2] - box[0], box[3] - box[1]
        scale, what = min(MAX_W / w, MAX_H / h, 1), (picture.size, self.rotation)
        (room_w, room_h), (cell_w, cell_h) = self.viewport(), self.kitty_cell()
        if part := self.part(box, min(MAX_W / w, MAX_H / h, CELL_PX * room_w / cell_w / w, CELL_PX * room_h / cell_h / h)):
            what, picture = part
            box, scale = (0, 0, *picture.size), 1
        self.cut = cut(picture, box, scale, GREY, what, self.cut)
        return self.cut[1]

    def show_next(self, images, at, offset):
        """Show the first image that opens, going offset places at a time from index at of
        images, wrapping round; the Path shown, None when none opens. Those passed over as too
        large are kept for the toast (passed())."""
        self.oversize = []
        for n in range(1, len(images) + 1):
            candidate = images[(at + offset * n) % len(images)]
            try:
                picture = open_picture(candidate)
            except TooLarge:
                self.oversize.append(candidate.name)
                continue
            if picture:
                self.show(str(candidate), picture)  # draw() cuts the frame, once for a batch of keys
                self.redraw(clear=True)
                return candidate

    def passed(self):
        """The toast's note on the images the last show_next passed over as too large."""
        return "".join(f"; {name} too large" for name in self.oversize)

    def entry(self):
        """The image on screen as the folder lists it: its folder resolved, its own name (a
        symlink stays itself)."""
        path = Path(self.path)
        return path.parent.resolve() / path.name

    def images(self):
        """This folder's images (sibling_images), kept while the folder's mtime stays."""
        folder = Path(self.path).parent.resolve()
        try:
            stamp = (folder, folder.stat().st_mtime_ns)
        except OSError:
            stamp = None
        if stamp is None or self.listing is None or self.listing[0] != stamp:
            self.listing = (stamp, sibling_images(self.path))
        return self.listing[1]

    def step(self, offset):
        """Move offset images along this folder, wrapping round. Only counted: a batch of held
        keys opens one image, in flush() (settle_step)."""
        if self.pending:
            images, at, steps = self.pending
        else:
            images, here = self.images(), self.entry()
            at, steps = next((i for i, f in enumerate(images) if f == here), 0), 0
        if images:
            self.pending = (images, at, steps + offset)
            self.redraw(clear=True)

    def settle_step(self):
        """Show the image the steps reached, as one press at a time would: each passes over the
        files that do not open. Those passed are told by their header (identifies), so only the
        last is decoded; should it fail all the same, the next that opens (their way)."""
        images, at, steps = self.pending
        self.pending = None
        way = 1 if steps >= 0 else -1
        for _ in range(abs(steps)):
            for _ in images:  # on to the next that looks like an image; with none, back here
                at = (at + way) % len(images)
                if identifies(images[at]):
                    break
        if candidate := self.show_next(images, at - way, way):
            self.say(f"{candidate.name}  {images.index(candidate) + 1}/{len(images)}{self.passed()}")

    def next_after(self, images, here):
        """here, a place in images (the folder's before it lost it), is gone: show the image
        after it by name, wrapping round, or the empty-folder screen when none left opens."""
        at = images.index(here) if here in images else None
        rest = images if at is None else images[at + 1 :] + images[:at]
        if not self.show_next([f for f in rest if f != here and f.exists()], -1, 1):
            self.show(self.path, None)
            self.empty, self.kitty = here.parent, (None, b"")
            self.redraw(clear=True)

    def trash_image(self):
        """d: the image on screen to the trash, then the next one of the folder."""
        self.remove_image(lambda path: self.trashed.append(trash(path)), "trash", "trashed")

    def delete_image(self):
        """y after D: the image on screen deleted for good, then the next one of the folder."""
        self.remove_image(lambda path: path.unlink(), "delete", "deleted")

    def remove_image(self, action, verb, done):
        """action(path) on the image on screen, then the next one of the folder and the toast
        "<done> <name>"; when action raises OSError, "<verb> failed", nothing else."""
        path, images, here = Path(self.path), self.images(), self.entry()
        try:
            action(path)
        except OSError:
            self.say(f"{verb} failed")
            return self.redraw()
        self.listing = None
        self.next_after(images, here)
        self.say(f"{done} {path.name}{self.passed()}")

    def confirm(self, k):
        """The key after D: y deletes, any other keeps the image; either way it is used up."""
        self.confirming = False
        if k == b"y":
            return self.delete_image()
        self.say(f"kept {Path(self.path).name}")
        self.redraw()

    def undo_trash(self):
        """u: the last image trashed back where it was, and on screen (from the empty folder
        too). One that cannot go back stays on the stack."""
        if not self.trashed:
            self.say("nothing to undo")
            return self.redraw()
        entry = self.trashed[-1]
        try:
            untrash(entry)
        except FileExistsError:
            self.say(f"cannot restore: {entry.path.name} exists")
            return self.redraw()
        except TrashGone:  # nothing to put back, and it would block the earlier entries for good
            self.trashed.pop()
            self.say(f"{entry.path.name} is no longer in the trash")
            return self.redraw()
        except OSError:
            self.say("restore failed")
            return self.redraw()
        self.trashed.pop()
        self.listing = None
        try:
            picture = open_picture(entry.path)
        except TooLarge:  # replaced meanwhile by one too large to show: it is back all the same
            picture = None
        if picture:
            self.show(str(entry.path), picture)
        self.say(f"restored {entry.path.name}")
        self.redraw(clear=True)

    def rotate(self, turns):
        self.rotation = (self.rotation + turns) % 4
        self.reset_view()
        self.redraw(clear=True)

    def kitty_image(self, cols, rows, again):
        """The visible part of the still image itself over the kitty graphics protocol, fitted
        and centred in the window; b"" when that is on screen already, unless again. It sits
        under the text layer (z=-1), so the status line and toasts stay on top."""
        picture, box = self.visible()
        cell_w, cell_h = self.kitty_cell()
        scale = min(self.scale(), cols * cell_w / (box[2] - box[0]), rows * cell_h / (box[3] - box[1]))
        what = (self.path, self.rotation, picture.size)
        if part := self.part(box, scale):  # a zoomed SVG at one raster px per screen px
            what, picture = part
            box, scale = (0, 0, *picture.size), 1
        return self.kitty_place(picture, what, 1, 1, cols, rows, box, scale, again)

    def kitty_cell(self):
        """A cell's size in px (window())."""
        return self.window()[2:]

    def kitty_place(self, picture, key, col, row, cols, rows, box, scale, again):
        """The box (left, top, right, bottom) of picture, in its px, over the kitty graphics
        protocol at scale screen px per picture px, but no larger than the box of cols x rows
        cells whose top left cell is (col, row) holds, centred there under the text layer
        (kitty_pixels). Transparency shows over a checkerboard. The scaled pixels are kept
        until key, the box or the scale changes; without again, b"" when they are where they
        would go already."""
        from PIL import Image

        cell_w, cell_h = self.kitty_cell()
        left, top, right, bottom = box
        scale = min(scale, cols * cell_w / (right - left), rows * cell_h / (bottom - top))
        squares = lambda size: Image.frombytes("RGB", size, checkerboard(size))
        self.kitty = cut(picture, box, scale, squares, key, self.kitty)
        spot = (self.kitty[0], col, row, cols, rows)
        if not again and self.placed == spot:
            return b""
        self.placed = spot
        w, h, rgb = self.kitty[1]
        return self.kitty_pixels(w, h, rgb, 24, col, row, cols, rows)

    def kitty_pixels(self, w, h, data, fmt, col, row, cols, rows):
        """w x h pixels as they are (fmt 24: RGB, 32: RGBA), centred in the box of cols x rows
        cells at (col, row), under the text layer, in the cells they cover. The pixels go raw
        through a /dev/shm file that kitty reads and deletes (t=t: the name has to say
        tty-graphics-protocol): no PNG to encode, no megabytes of base64 down the terminal."""
        cell_w, cell_h = self.kitty_cell()
        c, r = min(cols, max(1, round(w / cell_w))), min(rows, max(1, round(h / cell_h)))
        self.drop_shm()  # kitty has read it by now; one it never read (not kitty) must not pile up in RAM
        fd, path = tempfile.mkstemp(prefix="tty-graphics-protocol-", dir="/dev/shm")
        self.shm_file = path
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        head = b"a=T,f=%d,t=t,s=%d,v=%d,c=%d,r=%d,C=1,z=-1,q=2" % (fmt, w, h, c, r)
        return b"\x1b[%d;%dH\x1b_G%s;%s\x1b\\" % (
            row + (rows - r) // 2, col + (cols - c) // 2, head, base64.b64encode(path.encode()))

    def drop_shm(self):
        if getattr(self, "shm_file", None):
            Path(self.shm_file).unlink(missing_ok=True)
            self.shm_file = None

    def open_page(self):
        """r: the render page for the picture on screen (the still image as turned, or the
        video frame shown, from the file at full size). Playback pauses meanwhile."""
        at = None if self.still else self.shown_time()
        picture = flatten(self.turned(), GREY) if self.still else convert_module().frame_at(self.path, at)
        name = Path(convert_module().out_name(self.path, at))
        self.resume_after = self.state == PLAYING
        if self.resume_after:
            self.pause()
        self.page = RenderPage(self, picture, name)
        self.redraw()

    def open_help(self):
        """F1: the keys (HELP) over the screen; a video pauses meanwhile. The scope of audio alone
        is stopped, its cursor and colour saved (it sets the colour once), so it does not draw over
        them."""
        self.help, self.help_resume = 0, self.state == PLAYING and not self.still
        if self.help_resume:
            self.pause()
        if self.scope and self.scope.poll() is None:
            os.kill(self.scope.pid, signal.SIGSTOP)
            for _ in range(50):  # stopped, so none of its writes lands in the keys
                try:
                    if Path(f"/proc/{self.scope.pid}/stat").read_text().rsplit(")", 1)[1].split()[0] == "T":
                        break
                except (OSError, IndexError):
                    break
                time.sleep(0.002)
            sys.stdout.buffer.write(b"\x1b7")
            sys.stdout.buffer.flush()
        self.redraw(clear=True)

    def help_key(self, k):
        """A key while the keys show: j k Down Up scroll them when they do not fit, any other closes them."""
        lines = HELP[1 if self.page else 0]
        room = self.window()[1] - 1
        if k in (b"j", b"\x1b[B", b"k", b"\x1b[A") and len(lines) > room:
            step = 1 if k in (b"j", b"\x1b[B") else -1
            self.help = min(max(self.help + step, 0), len(lines) - room)
            return self.redraw()
        self.help = None
        self.placed = None  # the image, the page's preview, the scope's screen: drawn again
        if self.page:
            self.page.shown = self.page.crop_view = None
        if self.scope and self.scope.poll() is None:
            sys.stdout.buffer.write(b"\x1b[2J\x1b8")
            sys.stdout.buffer.flush()
            os.kill(self.scope.pid, signal.SIGCONT)
        if self.help_resume:
            self.resume()
        self.redraw(clear=True)

    def help_screen(self, cols, rows):
        """The keys from line self.help on, and a hint on the bottom row."""
        lines = HELP[1 if self.page else 0]
        room = max(rows - 1, 1)
        self.help = min(self.help, max(len(lines) - room, 0))
        out = [b"\x1b[?2026h\x1b[0m", KITTY_CLEAR, b"\x1b[2J"]
        for i, line in enumerate(lines[self.help : self.help + room]):
            out.append(b"\x1b[%d;1H %s" % (i + 1, line[: cols - 1].encode()))
        hint = ("j k scroll   " if len(lines) > room else "") + "any other key closes"
        out.append(b"\x1b[%d;1H\x1b[2m %s\x1b[0m\x1b[?2026l" % (rows, hint[: cols - 1].encode()))
        return b"".join(out)

    def close_page(self):
        self.page.stop()
        self.page = None
        sys.stdout.buffer.write(KITTY_CLEAR + b"\x1b[2J")
        if self.resume_after:
            self.resume()
        self.redraw(clear=True)

    def frame_time(self):
        """The media time of the frame on screen: the decoder's n-th since the start at base."""
        return self.base + max(self.n - 1, 0) * self.period

    def shown_time(self):
        """frame_time() to 0.1 s (it names a screenshot)."""
        return round(self.frame_time(), 1)

    def say(self, text):
        self.toast, self.toast_until = text, time.monotonic() + TOAST

    def toast_left(self):
        """Seconds until the toast expires; None when there is none."""
        return max(self.toast_until - time.monotonic(), 0) if self.toast else None

    def ended(self):
        """The end of the file: start over with loop on, else quit, as mpv does."""
        if self.loop and self.n:  # a run that made no frames would respawn forever
            self.halt()
            self.start()
        else:
            sys.exit(0)

    def status(self, cols, row):
        """The status line as positioned writes on row: a toast while one shows, else cmus's
        state, time and progress line (none for a still), and L at the right edge while
        looping. Only the text itself is written, so what is under it (the picture) shows past
        its end. A pending D question shows instead of any toast, however long it waits."""
        if self.confirming:
            tail = " permanently? y/n"
            name = Path(self.path).name
            room = max(cols - 2 - len("delete ") - len(tail), 1)
            name = name if len(name) <= room else name[: room - 1] + "…"
            return b"\x1b[%d;1H\x1b[7m %s \x1b[0m" % (row, f"delete {name}{tail}".encode())
        if self.toast and time.monotonic() < self.toast_until:
            return b"\x1b[%d;1H\x1b[7m %s \x1b[0m" % (row, self.toast[: cols - 2].encode())
        if self.still:
            return b""
        mark = {PLAYING: ">", PAUSED: "|", STOPPED: "."}[self.state]
        clock = lambda t: f"{int(t) // 60:02d}:{int(t) % 60:02d}"
        now = min(self.clock(), self.length)
        text = f"{mark} {clock(now)}" + (f" / {clock(self.length)}" if self.length != math.inf else "")
        room = cols - len(text) - (4 if self.loop else 1)
        bar = "━" * round(room * now / self.length) if self.length not in (0, math.inf) and room > 0 else ""
        out = b"\x1b[%d;1H\x1b[0m%s" % (row, f"{text} {bar}".rstrip()[:cols].encode())
        if self.loop:
            out += b"\x1b[%d;%dHL" % (row, cols)
        return out + b"\x1b[0m"

    def notice(self, cols, rows):
        """The empty folder's two lines, centred: what is missing, and the keys that answer."""
        hint = ("u undo  " if self.trashed else "") + "q quit"
        out = []
        for i, (text, style) in enumerate(((f"no images in {self.empty.name or self.empty}", b""), (hint, b"\x1b[2m"))):
            text = text[:cols]
            out.append(b"\x1b[%d;%dH%s%s\x1b[0m" % (max(rows // 2, 1) + i, (cols - len(text)) // 2 + 1, style, text.encode()))
        return b"".join(out)

    def draw(self, clear=False):
        cols, rows = self.window()[:2]
        if self.help is not None:
            out = self.help_screen(cols, rows)
        elif self.page:
            out = self.page.draw(cols, rows)
        elif not self.has_video:  # the scope owns the screen but its spare bottom row
            # DECSC/DECRC keep the scope's cursor and colour: this may land amid its own writes
            out = b"\x1b7\x1b[%d;1H\x1b[0m\x1b[2K%s\x1b8" % (rows, self.status(cols, rows))
        else:  # synchronized update: no tearing between rows
            out = b"\x1b[?2026h\x1b[0m" + self.screen(cols, rows, clear) + self.status(cols, rows) + b"\x1b[?2026l"
        sys.stdout.buffer.write(out)
        sys.stdout.buffer.flush()

    def screen(self, cols, rows, clear):
        """The picture (or the empty folder's notice) on screen, as escape bytes; the status
        line goes over its bottom row."""
        if self.empty:
            self.placed = None
            return KITTY_CLEAR + b"\x1b[2J" + self.notice(cols, rows)
        if self.still and self.pixels:
            place = self.kitty_image(cols, rows, again=clear)
            if not place:  # the image is there already: the status row alone, which shows it through when cleared
                return b"\x1b[%d;1H\x1b[2K" % rows
            return KITTY_CLEAR + b"\x1b[2J" + place
        buf = []
        if self.still:  # an image shown over the kitty protocol goes
            buf.append(KITTY_CLEAR)
            self.placed = None
        if clear:
            buf.append(b"\x1b[2J")
        buf.append(b"\x1b[%d;1H\x1b[2K" % rows)  # the last status, where the picture leaves blank
        # a still's view may have moved since the last draw: this is where it is cut
        frame = self.thumbnail() if self.still else self.frame
        if frame:
            cell_w, cell_h = self.kitty_cell()
            look = (cols, rows, cell_w / cell_h, self.lut, self.mono, self.glyphs, self.bold, self.saturation)
            if not (self.rendered and self.rendered[0] is frame and self.rendered[1] == look):  # else a status-only redraw
                w, h, data = frame
                data = data.translate(self.lut) if self.lut else data
                self.rendered = (frame, look, self.term.render((w, h, data), cols, rows, cell_w / cell_h, self.mono,
                                                               self.glyphs, self.bold))
            cw, ch, out = self.rendered[2]
            top, left = (rows - ch) // 2, (cols - cw) // 2
            for i, line in enumerate(out.split(b"\n")[:ch]):
                buf.append(b"\x1b[%d;%dH%s%s\x1b[0m" % (top + i + 1, left + 1, b"\x1b[1m" if self.bold else b"", line))
        return b"".join(buf)

    def key(self, k):
        if k in HELP_KEYS and not self.confirming:  # after D, F1 is a key that keeps the image
            return self.open_help()
        if self.page:  # the render page takes every key; poll() redraws it after a batch
            if self.page.key(k) == "close":
                self.close_page()
            return
        if self.still:  # an image: qView's keys for the folder and rotation, no time or sound
            if self.pending and k not in IMAGE_STEPS:  # the next key acts on the image the steps reached
                self.settle_step()
            if self.confirming:
                return self.confirm(k)
            if k == b"u":
                return self.undo_trash()
            if self.empty and k not in (b"q", b"Q", b"f"):  # no picture: nothing else has anything to act on
                return
            if k == b"d":
                return self.trash_image()
            if k == b"D":
                self.confirming = True
                return self.redraw()
            if k in IMAGE_ZOOMS:
                return self.zoom_by(IMAGE_ZOOMS[k])
            if k in (b"\x7f", b"\x08"):
                return self.zoom_by(-self.steps())
            if k in IMAGE_PANS and self.steps():  # zoomed in, the move keys pan
                return self.pan_by(*IMAGE_PANS[k])
            if k in IMAGE_STEPS:
                return self.step(IMAGE_STEPS[k])
            if k in IMAGE_TURNS:
                return self.rotate(IMAGE_TURNS[k])
            if k == b"v":
                self.pixels = not self.pixels
                self.say("image" if self.pixels else "ascii")
                return self.redraw(clear=True)
            if k == b"y":
                self.copy_image()
                return self.redraw()
            if k not in (b"q", b"Q", b"`", b"f", b"s", b"b", b"c", b"g", b"r", *LEVELS, *CONTRASTS, *SATURATIONS):
                return
        if not self.has_video and k not in AUDIO_KEYS:  # the oscilloscope: level, mono and the rest do nothing
            return
        if k in (b"q", b"Q"):
            sys.exit(0)
        elif k in (b" ", b"p"):
            if self.state == PLAYING:
                self.pause()
            elif self.state == PAUSED:
                if self.held is not None:  # the decoder is ahead of the frame on screen: seek there
                    self.seek_to(self.held * self.period)
                self.resume()
            else:
                self.start()
        elif k in SEEKS:
            self.seek(SEEKS[k])
        elif k in SPEEDS:
            self.set_speed(round(SPEEDS[k](self.speed)))
            self.say(f"speed {self.speed}%")
        elif k in LEVELS or k in CONTRASTS or k == b"`":
            if k == b"`":
                self.level = self.contrast = 0
                self.say("level 0, contrast 0")
            elif k in LEVELS:
                self.level = clamp("level", self.level + LEVELS[k])
                self.say(f"level {tone_label(self.level)}")
            else:
                self.contrast = clamp("contrast", self.contrast + CONTRASTS[k])
                self.say(f"contrast {contrast_label(self.contrast)}")
            self.lut = tone_table(self.level, self.contrast)
        elif k in SATURATIONS:
            self.saturation = clamp("saturation", self.saturation + SATURATIONS[k])
            self.term.saturate(self.saturation)
            self.say(f"saturation {self.saturation}%")
        elif k == b"g":
            self.glyphs = next_glyphs(self.glyphs)
            self.say(f"glyphs: {self.glyphs}")
        elif k == b"b":
            self.bold = not self.bold
            self.say("bold" if self.bold else "regular")
        elif k == b"r":
            return self.open_page()
        elif k in (b".", b","):
            self.frame_step(1 if k == b"." else -1)
        elif k == b"s" and (self.still or self.frame):  # a video's once its first frame is up
            self.screenshot()
        elif k == b"f":
            self.fullscreen()
        elif k in VOLUMES:
            self.set_volume(VOLUMES[k])
            self.say("silent" if self.volume is None else f"volume {round(self.volume)}")
        elif k == b"c":
            self.mono = not self.mono
            self.say("mono" if self.mono else "colour")
        elif k == b"m":
            self.set_mute(not self.muted)
            self.say("muted" if self.muted else "unmuted")
        elif k == b"L":
            self.loop = not self.loop
            if not self.has_video:
                self.mpv("set_property", "loop-file", "inf" if self.loop else "no")
            self.say(f"loop {'on' if self.loop else 'off'}")
        self.redraw()

    def redraw(self, clear=False):
        """Mark the screen for the next flush(): a held key's batch of repeats draws once."""
        self.stale = max(self.stale, 2 if clear else 1)

    def flush(self):
        if self.pending:
            self.settle_step()
        if self.stale:
            clear, self.stale = self.stale == 2, 0
            self.draw(clear=clear)

    def poll(self, timeout):
        """Wait up to timeout seconds (None: forever) for a key or a resize, and act on it."""
        ready = select.select([0, self.winch, self.remote_r], [], [], timeout)[0]
        if self.winch in ready:
            os.read(self.winch, 64)
            self.geometry = None  # the window changed: window() measures it again
            self.draw(clear=True)
        if self.remote_r in ready:
            os.read(self.remote_r, 64)
            self.remote()
        if 0 in ready:
            data = os.read(0, 4096)  # every key waiting: a held key's backlog in one go
            if not data:  # the terminal is gone
                sys.exit(0)
            # a sequence cut by the read's end: the rest follows at once; a lone Esc has none
            while PARTIAL.search(data) and select.select([0], [], [], 0.05)[0] and (more := os.read(0, 4096)):
                data += more
            # keys that piled up while a seek ran (a held arrow) add up to a single seek
            delta = 0
            for k in KEY.findall(data):
                if REPLY.match(k):  # the terminal answering a question, late: not typed
                    continue
                if self.help is not None:  # the keys on screen take every key: none reaches the player
                    self.help_key(k)
                    continue
                if k in SEEKS and not self.still and not self.page:
                    delta += SEEKS[k]
                    continue
                if delta:
                    self.seek(delta)
                    delta = 0
                self.key(k)
            if delta:
                self.seek(delta)
                self.redraw()
            if self.page:
                self.redraw()
        self.flush()

    def wait_key(self):
        """poll() until a key or the toast's end; then the status row without the toast."""
        self.poll(self.toast_left())
        if self.toast and time.monotonic() >= self.toast_until:
            self.toast = ""
            self.draw()

    def run(self):
        """The main loop. A still waits for keys. Otherwise a frame shows when the clock
        (position: mpv's time-pos, carried on by a monotonic clock, which runs alone without
        audio or after it) reaches its time, and is dropped when drawing runs late, so pause,
        seek, speed and loop cannot drift; audio alone redraws the status until mpv exits."""
        if self.still:  # one frame, held until q
            self.draw()
            while True:
                self.wait_key()
        self.serve_mpris()
        if not self.has_video:
            self.scope = subprocess.Popen(
                [*CHILD, SCOPE], stdin=subprocess.DEVNULL,
                env={**os.environ, "SCOPE_SPARE_ROWS": "1", "SCOPE_TARGET": STREAM},
            )
        self.start()
        while True:
            if self.state != PLAYING:
                self.wait_key()
                continue
            if not self.has_video:  # mpv plays it all; its exit is the end
                self.poll(0.25)
                self.position()  # keeps the clock, and so MPRIS Position, on mpv's
                self.draw()  # the status line's time and progress
                if self.state == PLAYING and not (self.audio and self.audio.poll() is None):
                    self.ended()
                continue
            ts = self.advance()
            if ts is None:
                self.ended()
                continue
            if self.n == 1 and not self.ipc:  # local clock: start at the first frame, not at launch
                self.pos, self.mark = self.base, time.monotonic()
            proc = self.proc
            while self.state == PLAYING and self.proc is proc:  # a seek replaces proc
                left = ts - self.position()
                if left <= 0:
                    if left > -self.period:  # else late: drop
                        self.draw()
                    break
                self.poll(left * 100 / self.speed)


def ligatures(mode):
    """kitty's ligatures for this window (kitten @ over kitty's socket, when there is one): off
    while the viewer draws, since JetBrains Mono joins the dithered glyphs' runs ("!=", "<-",
    "==") into single symbols, and back to the config's default ("never") after. Quiet when
    this is not kitty."""
    sock, window = os.environ.get("KITTY_LISTEN_ON"), os.environ.get("KITTY_WINDOW_ID")
    if sock and window:
        subprocess.run(["kitten", "@", "--to", sock, "disable-ligatures", "--match", f"id:{window}", mode],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if len(sys.argv) != 2 or not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.exit("usage: ascii-viewer FILE (needs a terminal)")
    player = Player(sys.argv[1])
    saved = termios.tcgetattr(0)
    # the title lets a window manager's rule tell this window apart
    sys.stdout.write("\x1b[22;2t\x1b]2;ascii-viewer\x07\x1b[?1049h\x1b[?25l")  # push the title, then set ours
    sys.stdout.flush()
    ligatures("always")
    try:
        tty.setcbreak(0)
        if player.pixels and not kitty_reads_files():  # kitty by its variables, but not one that can read our files
            player.pixels = False
        for sig in (signal.SIGHUP, signal.SIGTERM):  # a closed window must not leave mpv playing
            signal.signal(sig, lambda *_: sys.exit(0))
        player.run()
    except KeyboardInterrupt:
        pass
    finally:
        # a window closing sends SIGHUP more than once: a second must not cut the cleanup short
        for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)
        player.halt()
        player.drop_shm()
        ligatures("never")
        if player.scope:
            player.scope.terminate()
            player.scope.wait()
        try:
            termios.tcsetattr(0, termios.TCSADRAIN, saved)
            sys.stdout.write(KITTY_CLEAR.decode() + "\x1b[?25h\x1b[?1049l\x1b[23;2t")  # and pop the title
            sys.stdout.flush()
        except OSError:  # the terminal is already gone
            pass


if __name__ == "__main__":
    main()
