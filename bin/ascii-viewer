AUDIO_KEYS = {b"q", b"Q", b" ", b"p", b"m", b"L", b"f", *SEEKS, *SPEEDS, *VOLUMES}  # no picture to adjust
IMAGE_STEPS = {b"h": -1, b"\x1b[D": -1, b"l": 1, b"\x1b[C": 1}  # images: qView's previous, next
IMAGE_TURNS = {b"\x1b[A": 1, b"\x1b[B": -1, b"k": 1, b"j": -1}  # images: qView's Up rotates right, Down left
IMAGE_ZOOMS = {b"+": 1, b"=": 1, b"-": -1}  # images: zoom steps (= is + unshifted)
IMAGE_PANS = {  # images, zoomed in: the view's move, in its width and height; shifted a sixteenth
    b"h": (-1 / 4, 0), b"\x1b[D": (-1 / 4, 0), b"l": (1 / 4, 0), b"\x1b[C": (1 / 4, 0),
    b"k": (0, -1 / 4), b"\x1b[A": (0, -1 / 4), b"j": (0, 1 / 4), b"\x1b[B": (0, 1 / 4),
    b"H": (-1 / 16, 0), b"\x1b[1;2D": (-1 / 16, 0), b"L": (1 / 16, 0), b"\x1b[1;2C": (1 / 16, 0),
    b"K": (0, -1 / 16), b"\x1b[1;2A": (0, -1 / 16), b"J": (0, 1 / 16), b"\x1b[1;2B": (0, 1 / 16),
}
HELP_KEYS = {b"\x1bOP", b"\x1b[11~", b"\x1b[P"}  # F1, as kitty and xterm send it, and rxvt
KITTY_CLEAR = b"\x1b_Ga=d,d=A,q=2\x1b\\"  # deletes every image this window shows over the kitty protocol
