SGR_TEXT = re.compile(r"\x1b\[[0-9;]*m")  # colour codes in a line: no width on screen
# one key: a CSI or SS3 sequence, or a byte; or, whole, a terminal's reply (REPLY): an APC string,
# a CSI with "?" (device attributes), as kitty_reads_files asks for and may stop waiting for
KEY = re.compile(rb"\x1b_[^\x1b]*\x1b\\|\x1b\[[?0-9;]*[A-Za-z~]|\x1bO.|.", re.S)
REPLY = re.compile(rb"\x1b(_|\[\?)")  # a KEY token that is a terminal's reply, no key
PARTIAL = re.compile(rb"\x1b(\[[?0-9;]*|O|_[^\x1b]*)?\Z")  # a read that ends inside an escape sequence or a reply (or on a lone Esc)
PROBE_WAIT = 1.0  # seconds kitty_reads_files waits for the terminal's answer; a later one is dropped as it comes
